# Copy this file to .env and fill in your Bryce 3D serial number to skip the first-run prompt
BRYCE_NAME=Bryce User
BRYCE_ORG=Studio
BRYCE_SERIAL=

# Optional: virtual display resolution (default 640x480 fills the browser cleanly;
# use 800x600 or 1024x768 if you resize Bryce's canvas via File -> Document Setup)
# RESOLUTION=640x480
